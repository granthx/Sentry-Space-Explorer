# Copy this file to ".env" (same folder) and fill in your values.
# Never commit the real .env file.

# Get a free key (instant) at https://api.nasa.gov
# DEMO_KEY works for a first look but is limited to 30 requests/hour per IP.
NASA_API_KEY=NfMkz8BDcQrgkKMjDwr8nchmg6mPDbFHdjLq99h8

# How long successful NASA responses are cached in memory (seconds).
CACHE_TTL_SECONDS=900

# When true, the backend also serves the ../frontend folder at http://localhost:8000
SERVE_FRONTEND=true

# Comma-separated origins allowed to call the API from a browser
# (only needed if you serve the frontend from somewhere else).
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# AI Assistant (Groq API)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

